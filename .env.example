# ============================================================================
# STEWARD — The AP Clerk That Can't Be Tricked
# Environment Configuration (.env.example)
# ============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Operating Mode: "simulation" (default for zero-wallet judge exploration) or "live"
STEWARD_MODE=simulation

# ----------------------------------------------------------------------------
# 1. NEAR AI Cloud (Track 03 — Privacy & Private AI)
# ----------------------------------------------------------------------------
# Base URL for OpenAI-compatible NEAR AI Cloud Confidential Inference
NEAR_AI_BASE_URL=https://cloud-api.near.ai/v1
# API Key for NEAR AI Cloud (/v1/chat/completions).
# Note: /v1/models and /v1/attestation/report work publicly without an API key!
NEAR_AI_API_KEY=
# Default TEE-hosted open-weight model owned by nearai
NEAR_AI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8

# ----------------------------------------------------------------------------
# 2. NEAR Blockchain & Counterparty Intelligence (Track 06 — AI Security)
# ----------------------------------------------------------------------------
NEAR_NETWORK=mainnet
NEAR_RPC_MAINNET_URL=https://rpc.mainnet.near.org
NEAR_RPC_TESTNET_URL=https://rpc.testnet.near.org

# ----------------------------------------------------------------------------
# 3. NEAR Intents 1Click API (Track 08 — Real-World Money)
# ----------------------------------------------------------------------------
ONECLICK_API_BASE_URL=https://1click.chaindefuser.com
# Optional JWT token if using authenticated partner tier on 1Click API
ONECLICK_API_KEY=

# ----------------------------------------------------------------------------
# 4. Treasury Custody & Execution Safety Gate
# ----------------------------------------------------------------------------
# Custody Provider: "outlayer" | "scoped_signer" | "simulation"
TREASURY_CUSTODY_MODE=simulation

# OutLayer Agent Custody (TEE-enforced wallet custody on NEAR)
OUTLAYER_API_BASE_URL=https://api.outlayer.ai
OUTLAYER_API_KEY=

# Treasury Refund & Origin Account (used as refundTo in 1Click EXACT_OUTPUT quotes)
TREASURY_NEAR_ACCOUNT_ID=treasury.steward-ap.near

# Explicit Product-Owner Safety Gate:
# Must be explicitly set to "true" to broadcast irreversible mainnet transactions.
ALLOW_MAINNET_EXECUTION=false
